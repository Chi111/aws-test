CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# DATABASE_SSL_CA_PATH=/absolute/path/to/global-bundle.pem
JWT_SECRET=dev-only-change-me-jwt-secret-32-chars
RELEASE_VERSION=local
# PROFILE_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-2:123456789012:github-profile-events
METRIC_SERVICE_NAME=github-profile-sam-local
PERFORMANCE_HASH_SECRET=dev-performance-hash-secret-change-me
PERFORMANCE_INGEST_ENABLED=true
PERFORMANCE_WORKER_POLL_INTERVAL_MS=2000
PERFORMANCE_WORKER_BATCH_SIZE=100
PERFORMANCE_RAW_RETENTION_DAYS=7
PERFORMANCE_CLEAN_RETENTION_DAYS=90
NODE_ENV=development
