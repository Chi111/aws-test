FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

# Build the bundled server artifacts before building this image:
# pnpm --filter server build
COPY --chown=node:node apps/server/dist ./dist
COPY --chown=node:node global-bundle.pem /etc/ssl/certs/aws-rds-global-bundle.pem

USER node

CMD ["node", "dist/performance-log-worker.mjs"]
