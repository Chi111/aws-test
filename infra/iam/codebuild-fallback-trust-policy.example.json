{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustCodeBuildService",
      "Effect": "Allow",
      "Principal": {
        "Service": "codebuild.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    },
    {
      "Sid": "TrustOnlyTheGitHubTriggerRoleForFallbackChaining",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::311816466050:role/github-profile-pr-trigger-role"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
