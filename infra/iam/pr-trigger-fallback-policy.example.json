{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunTheTrustedCodeBuildProject",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": "arn:aws:codebuild:us-east-2:311816466050:project/github-profile-pr-environment"
    },
    {
      "Sid": "ChainIntoTheExistingBuildRoleWhenCodeBuildIsUnavailable",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::311816466050:role/github-profile-codebuild-role"
    }
  ]
}
